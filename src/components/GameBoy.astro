---
import { getCollection, getEntry } from 'astro:content';
import Controls from './gameboy/Controls.astro';
import Hud from './gameboy/Hud.astro';
import PowerSwitch from './gameboy/PowerSwitch.astro';
import TabsHeader from './gameboy/TabsHeader.astro';
import TurnButton from './gameboy/TurnButton.astro';
import LinksTab from './gameboy/tabs/LinksTab.astro';
import AboutTab from './gameboy/tabs/AboutTab.astro';
import HelpTab from './gameboy/tabs/HelpTab.astro';
import SnakeTab from './gameboy/tabs/SnakeTab.astro';
import '../styles/hit-areas.css';
import '../styles/console-layout.css';
import '../styles/view-transitions.css';
import '../styles/screen.css';
import '../styles/controls.css';
import '../styles/pause-menu.css';
import '../styles/responsive.css';

const allLinks = await getCollection('links');
const sortedLinks = allLinks.sort((a, b) => a.data.order - b.data.order);
const aboutEntry = await getEntry('sections', 'about');
const aboutText = aboutEntry && aboutEntry.body ? aboutEntry.body.trim() : '';
---

<main class="console">
    <h1 class="sr-only">Swapnil Sharma</h1>
    <div class="console-body">
        <PowerSwitch />
        <Controls />

        <section class="screen-lens">
            <div class="power-indicator">
                <span class="led"></span>
            </div>
            <div class="screen-display" id="main-screen">
                <div id="start-overlay">
                    <div class="start-content">
                        <h2>SYSTEM BOOT</h2>
                        <p class="blink">PRESS ANY BUTTON OR CLICK ANYWHERE</p>
                    </div>
                </div>
                <div id="boot-screen" class="boot-screen">
                    <div class="progress-container">
                        <div class="progress-bar"></div>
                    </div>
                    <p class="boot-status" aria-live="polite">CONTROLS LOCKED · BOOTING…</p>
                </div>

                <Hud />

                <div class="battery" id="battery-indicator">
                    <div class="battery-level" id="battery-level"></div>
                </div>

                <TabsHeader />

                <div class="tab-container">
                    <div class="tab-content active" id="tab-0" role="tabpanel" aria-labelledby="tab-ind-0">
                        <LinksTab links={sortedLinks} />
                    </div>
                    <div class="tab-content" id="tab-1" role="tabpanel" aria-labelledby="tab-ind-1" hidden>
                        <AboutTab aboutText={aboutText} />
                    </div>
                    <div class="tab-content" id="tab-2" role="tabpanel" aria-labelledby="tab-ind-2" hidden>
                        <HelpTab />
                    </div>
                    <div class="tab-content" id="tab-3" role="tabpanel" aria-labelledby="tab-ind-3" hidden>
                        <SnakeTab />
                    </div>
                </div>

                <div class="pause-menu" id="pause-menu" role="dialog" aria-modal="true" aria-label="Pause menu" tabindex="-1" hidden>
                    <h2 class="pause-menu-title" id="pause-menu-title">PAUSE</h2>
                    <ul class="pause-menu-list" id="pause-menu-list" role="menu" aria-labelledby="pause-menu-title" tabindex="-1">
                        <li class="pause-menu-item" id="pause-menu-item-0" data-action="resume" role="menuitem" tabindex="-1"><span class="pause-menu-label">RESUME</span></li>
                        <li class="pause-menu-item" id="pause-menu-item-1" data-action="theme" role="menuitem" tabindex="-1"><span class="pause-menu-label">THEME</span></li>
                        <li class="pause-menu-item" id="pause-menu-item-2" data-action="sound" role="menuitem" tabindex="-1"><span class="pause-menu-label">SOUND: ON</span></li>
                        <li class="pause-menu-item" id="pause-menu-item-3" data-action="help" role="menuitem" tabindex="-1"><span class="pause-menu-label">HELP</span></li>
                        <li class="pause-menu-item" id="pause-menu-item-4" data-action="power" role="menuitem" tabindex="-1"><span class="pause-menu-label">POWER OFF</span></li>
                    </ul>
                    <p class="pause-menu-hint">UP/DOWN: MOVE | A: OK | B: CLOSE</p>
                </div>

                <footer class="footer">
                    <p id="footer-hint">UP/DOWN: LINKS | A: OPEN | L/R: TABS</p>
                </footer>
            </div>
            <div class="logo">GAME BOY <span class="advance">ADVANCE</span></div>
        </section>

        <div class="speaker" aria-hidden="true">
            <span style="view-transition-name: s1"></span>
            <span style="view-transition-name: s2"></span>
            <span style="view-transition-name: s3"></span>
            <span style="view-transition-name: s4"></span>
            <span style="view-transition-name: s5"></span>
            <span style="view-transition-name: s6"></span>
        </div>
    </div>
</main>

<TurnButton />

<script>
    import '../lib/init';
</script>
